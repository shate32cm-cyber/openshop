    "dotenv": "^17.0.0",
    "zod": "^4.0.0",
    "helmet": "^8.0.0",
    "express-rate-limit": "^8.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0"
  }
}
