{
  "name": "mall",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" scripts/*.mjs README.md",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9"
  }
}
